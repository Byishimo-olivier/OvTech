# Copy to frontend/.env

# Where the backend runs. Vite forwards every /api request here (in `npm run dev` and `npm run preview`).
API_PROXY_TARGET=http://localhost:5000

# Port for the website (npm run dev / npm run preview).
FRONTEND_PORT=5173

# Only if the website is served WITHOUT the proxy above (e.g. plain static files on another host):
# the full backend address, baked in at build time. Leave empty to use the proxy.
VITE_API_BASE_URL=
