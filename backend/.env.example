# Copy to backend/.env

# Port the API listens on. The frontend's API_PROXY_TARGET must point here.
PORT=5000

# Public website address(es), comma-separated. Used for CORS and for "Back to site" links.
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=

# Where contact, live chat and "new subscriber" notifications are delivered.
MAIL_TO=your-inbox@gmail.com
# Sender shown on outgoing emails (defaults to EMAIL_USER). With Brevo this must be a verified sender.
MAIL_FROM=your-gmail-address@gmail.com
MAIL_FROM_NAME=Over Rentals

# --- Option A: Brevo HTTP API (required on Render's FREE plan, which blocks SMTP ports) ---
# Create a free account at brevo.com, verify your sender email, then create an API key
# (SMTP & API > API Keys) and a contact list (Contacts > Lists) for newsletter subscribers.
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Option B: Gmail SMTP (works locally and on hosts that allow SMTP) ---
# Used only when BREVO_API_KEY is empty. EMAIL_PASS is a Gmail App Password, not your login password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (default). 587 = STARTTLS; SMTP_SECURE is chosen from the port automatically.
SMTP_PORT=465
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
# Set to true to log the full SMTP conversation while debugging.
SMTP_DEBUG=false

# --- Newsletter ---
# Long random string used to sign unsubscribe links. Keep it stable or old links stop working.
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
# Long random string that protects /api/subscribers and /api/newsletter (used by `npm run newsletter`).
ADMIN_TOKEN=change-me-to-another-long-random-string
# Public site address used in unsubscribe links (Render sets RENDER_EXTERNAL_URL automatically).
PUBLIC_URL=
# Site that `npm run newsletter` talks to, e.g. https://your-site.onrender.com
SITE_URL=http://localhost:5000
# Without Brevo, subscribers are saved to this JSON file (default backend/data/subscribers.json).
# Note: Render's free plan wipes local files on every deploy/restart, so use Brevo there.
SUBSCRIBERS_FILE=
